{
  "name": "image-handler",
  "description": "A Lambda function for performing on-demand image edits and manipulations.",
  "main": "index.js",
  "author": {
    "name": "aws-solutions-builder"
  },
  "version": "5.0.0",
  "private": true,
  "dependencies": {
    "@aws-sdk/client-rekognition": "^3.1173.0",
    "@aws-sdk/client-s3": "^3.1173.0",
    "color": "3.1.2",
    "color-name": "1.1.4",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "mocha": "^11.7.0",
    "nyc": "^17.1.0",
    "sinon": "^21.0.0"
  },
  "scripts": {
    "test": "nyc --reporter=html --reporter=text mocha",
    "build": "npm ci --omit=dev --include=optional --ignore-scripts --os=linux --cpu=x64 --libc=glibc && npm run build:zip",
    "build:zip": "mkdir -p dist && rm -f dist/image-handler.zip && zip -rq dist/image-handler.zip *.js node_modules"
  },
  "license": "Apache-2.0"
}
